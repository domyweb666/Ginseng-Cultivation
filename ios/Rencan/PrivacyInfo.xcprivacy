<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 片 J1（2026-11-16）逐項判斷過，四個值都是查完才留空的，不是還沒填。依據寫在 docs/上架隱私填寫清單.md。 -->
	<!-- 追蹤：沒有。app 不連網、沒有廣告、沒有第三方 SDK。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- 蒐集的資料：沒有。Apple 的「蒐集」指資料傳出裝置；健康資料只在手機上讀、算、存，沒有任何網路請求。
	     之後只要加了會把資料送出手機的東西（分析、當機回報、雲端同步、帳號），這裡和 App Store 隱私標籤要一起改。 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- 需要申報理由的 API：2026-11-16 搜過 ios/Rencan 與 ios/RencanCore，@AppStorage、檔案時間戳、
	     開機時間、磁碟空間、鍵盤清單都沒用到。
	     UserDefaults 有兩種用法：
	     1. Services/WidgetBridge.swift 把小工具的快照寫進 App Group 那一格（組塊 G）。
	        理由代碼 1C8F.1：只讀寫同一個 App Group 裡的 app 與 extension 自己放的資料。
	        小工具的 target 有自己的一份（RencanWidget/PrivacyInfo.xcprivacy），兩邊要一起改。
	     2. 設定頁「一般」區的外觀、觸覺回饋（2026-11-19 加，VeggieKit 的 @AppStorage）。
	        理由代碼 CA92.1：只存 app 自己用的偏好，不給別的 app 看。 -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
